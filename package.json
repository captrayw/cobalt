{
  "name": "calm-scroll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Calm Scroll: a phone-first feed of full-screen colors and soft tones that slows into a breathing rhythm.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @calm/web dev",
    "build": "pnpm --filter @calm/web build",
    "preview": "pnpm --filter @calm/web preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r --reporter-hide-prefix typecheck",
    "test": "vitest run",
    "test:audio": "pnpm --filter @calm/audio test",
    "e2e": "pnpm --filter @calm/web e2e",
    "golden:export": "node golden/export.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:audio && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
